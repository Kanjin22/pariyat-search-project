# คัดลอกไฟล์นี้เป็น /etc/pariyat-search/pariyat-search.env แล้วใส่ค่าจริง
# แล้วสั่ง: sudo chmod 600 /etc/pariyat-search/pariyat-search.env
#          sudo systemctl restart pariyat-search

# ---- ความลับของแอป (ต้องตั้ง) ----
# สร้างค่าใหม่ได้ด้วย: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
STAFF_USERNAME=
# สร้าง hash ได้ด้วย: python scripts/generate_password_hash.py
STAFF_PASSWORD_HASH=

# ---- API ต้นทางข้อมูล (ไม่ใส่ก็ได้ แต่จะอัปเดตข้อมูลสดจาก API ไม่ได้) ----
# ค่าชุดนี้อยู่ใน Environment Variables ของ Render เดิม ให้คัดลอกเก็บก่อนลบ service
PARIYAT_API_URL=https://app.pariyat.com/pages/postx/name_json.php
PARIYAT_API_USER=
PARIYAT_API_PASS=
PARIYAT_CERT_API_URL=https://app.pariyat.com/pages/postx/license_json.php
PARIYAT_CERT_API_USER=
PARIYAT_CERT_API_PASS=
API_SNAPSHOT_MAX_AGE_HOURS=24
# ล็อกไม่ให้ระบบดึงข้อมูลจาก API สำหรับปีที่ <= ค่านี้ (เว้นว่าง = ล็อกอัตโนมัติถึงปีก่อนหน้า)
API_SNAPSHOT_LOCK_MAX_YEAR=
PUBLIC_CERTIFICATE_CACHE_TTL_SECONDS=300

# ---- ที่เก็บข้อมูลถาวร (สำคัญ: ต้องเป็น path นอก repo และไม่หายเมื่อ deploy ใหม่) ----
RESULTS_DATA_DIR=/var/lib/pariyat-search/data
BACKUPS_DIR=/var/lib/pariyat-search/backups
LOGS_DIR=/var/lib/pariyat-search/logs

# ---- Gunicorn (ดู deploy/gunicorn.conf.py) ----
GUNICORN_BIND=127.0.0.1:8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
GUNICORN_LOG_LEVEL=info
